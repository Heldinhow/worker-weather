  <ItemGroup>
    <ProjectReference Include="..\Polymarket.Bot.Infrastructure\Polymarket.Bot.Infrastructure.csproj" />
    <ProjectReference Include="..\Polymarket.Bot.Application\Polymarket.Bot.Application.csproj" />
  </ItemGroup>

</Project>
