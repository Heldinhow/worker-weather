# Database
ConnectionStrings__PolymarketDb=Host=localhost;Port=5432;Database=polymarket_bot;Username=polymarket;Password=polymarket_dev
Database__Provider=postgresql

# Redis
ConnectionStrings__Redis=localhost:6379,abortConnect=false

# Bot Settings
Bot__TradingMode=Paper
Bot__InitialBankroll=10000
Bot__EnableRealTrading=false
Bot__EnablePaperTrading=true

# Strategy Settings
Strategy__HighProb99C__EntryPriceThreshold=0.99
Strategy__HighProb99C__StopLossPercentage=0.20
Strategy__HighProb99C__MinEdgeBps=10
Strategy__HighProb99C__MinTrendConfidence=0.5
Strategy__HighProb99C__MinTrendStrength=0.3
Strategy__HighProb99C__MinLiquidity=25
Strategy__HighProb99C__MaxSpreadBps=100
Strategy__HighProb99C__MaxTradeAmount=25
Strategy__HighProb99C__RequireTrendAlignment=true

# Worker Settings
Worker__CycleIntervalSeconds=60
Worker__StopLossCheckEnabled=true
Worker__TrendAnalysisEnabled=true

# Polymarket API (Stub - replace with real in MVP 6)
Polymarket__ApiUrl=https://gamma-api.polymarket.com
Polymarket__UseStub=true

# Crypto Price Feed (Stub - replace with real in MVP 6)
CryptoPriceFeed__UseStub=true
CryptoPriceFeed__BtcStubPrice=105000
CryptoPriceFeed__EthStubPrice=3500

# Logging
Serilog__MinimumLevel=Information
